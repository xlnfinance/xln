{
  "name": "brainvault",
  "version": "2.2.0",
  "description": "Memory-hard deterministic wallet derivation with a fast Bun-native CLI",
  "type": "module",
  "license": "(MIT AND GPL-2.0-or-later)",
  "bin": {
    "brainvault": "brainvault"
  },
  "files": [
    "AGENTS.md",
    "LICENSE",
    "README.md",
    "brainvault",
    "docs/dependency-lock.audit",
    "docs/audit.md",
    "docs/manifest.sha256",
    "docs/media/",
    "docs/recovery.md",
    "docs/release.md",
    "docs/spec-v1.md",
    "src/core/",
    "src/cli/",
    "src/native/index.ts",
    "src/native/hybrid.ts",
    "src/native/shard-collector.ts",
    "src/native/children.ts",
    "src/native/progress.ts",
    "src/native/workers/",
    "src/native/prebuilds/",
    "src/native/source/benchmark.ts",
    "src/native/source/README.md",
    "src/native/source/c/Makefile",
    "src/native/source/c/brainvault_argon2.c",
    "src/native/source/c/compat/",
    "src/native/source/c/vendor/argon2/LICENSE",
    "src/native/source/c/vendor/argon2/include/argon2.h",
    "src/native/source/c/vendor/argon2/src/argon2.c",
    "src/native/source/c/vendor/argon2/src/core.c",
    "src/native/source/c/vendor/argon2/src/core.h",
    "src/native/source/c/vendor/argon2/src/encoding.c",
    "src/native/source/c/vendor/argon2/src/encoding.h",
    "src/native/source/c/vendor/argon2/src/opt.c",
    "src/native/source/c/vendor/argon2/src/thread.c",
    "src/native/source/c/vendor/argon2/src/thread.h",
    "src/native/source/c/vendor/argon2/src/blake2/",
    "src/native/source/c/vendor/sse2neon/sse2neon.h",
    "src/native/source/rust/.cargo/",
    "src/native/source/rust/Cargo.lock",
    "src/native/source/rust/Cargo.toml",
    "src/native/source/rust/Makefile",
    "src/native/source/rust/src/",
    "src/native/source/rust/vendor/",
    "src/native/source/metal/",
    "src/native/source/opencl/",
    "src/packaging/",
    "tests/core.test.ts",
    "tests/native-build.test.ts",
    "tests/native-hybrid.test.ts",
    "tests/package.test.ts",
    "tests/progress.test.ts",
    "tests/release-matrix.test.ts",
    "tests/sandbox.test.ts",
    "tests/data/",
    "tests/fixtures/"
  ],
  "scripts": {
    "check": "bun run test",
    "bench": "bun brainvault --bench",
    "smoke": "bun brainvault --smoke",
    "build:c": "make -C src/native/source/c all",
    "build:prebuild": "make -C src/native/source/c prebuild",
    "build:prebuild:m3": "make -C src/native/source/c prebuild-m3",
    "build:prebuild:rust": "make -C src/native/source/rust prebuild",
    "build:rust": "make -C src/native/source/rust all",
    "build:metal": "make -C src/native/source/metal all",
    "build:opencl": "make -C src/native/source/opencl all",
    "build:metal:prebuild": "make -C src/native/source/metal prebuild",
    "build:opencl:prebuild": "make -C src/native/source/opencl prebuild",
    "build:experimental": "bun run build:c && bun run build:rust && bun run build:metal && bun run build:opencl",
    "manifest": "bun src/packaging/manifest.ts",
    "test": "bun test tests/core.test.ts tests/native-hybrid.test.ts tests/progress.test.ts tests/sandbox.test.ts tests/package.test.ts",
    "test:matrix": "bun test tests/release-matrix.test.ts",
    "test:native-release": "bun test tests/native-build.test.ts",
    "verify:source": "bun test tests/native-build.test.ts"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "@node-rs/argon2": "2.1.0",
    "ethers": "6.17.0",
    "hash-wasm": "4.12.0"
  },
  "engines": {
    "bun": ">=1.2.0"
  },
  "packageManager": "bun@1.4.0",
  "publishConfig": {
    "access": "public"
  }
}
