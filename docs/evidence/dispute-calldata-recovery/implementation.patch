+    expect(await read(tx.hash, 'DisputeStarted', argsFor(body), location)).toEqual(body);
+    expect(await read(tx.hash, 'DisputeStarted', { ...argsFor(body), nonce: 8n }, location)).toEqual(body);
+    expect(bytes).toBe(encodedBodyBytes(body));
