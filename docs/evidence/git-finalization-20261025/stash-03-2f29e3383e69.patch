+import { expect, test } from 'bun:test';
+import { AbiCoder, ZeroHash, keccak256 } from 'ethers';
+import { Depository__factory } from '../../jurisdictions/typechain-types';
+import { decodeDisputeFinalizationEvidenceCalldata, resolveDisputeFinalizationEvidence } from '../jurisdiction/adapter/rpc-public';
+import { encodeInt512 } from '../protocol/crypto/abi-money';
+
+test('delegated finalization authenticates the effective empty signature and rejects the repeated calldata signature', () => {
+  const sender = `0x${'11'.repeat(32)}`;
+  const proof = {
+    counterentity: `0x${'22'.repeat(32)}`, initialNonce: 7n, finalNonce: 11n,
+    proposerIsLeft: false, initialProofbodyHash: ZeroHash, startedByLeft: true, cooperative: false,
+    finalProofbody: { watchSeed: ZeroHash, leftResponseSeconds: 10, rightResponseSeconds: 10,
+      offdeltas: [encodeInt512(0n)], tokenIds: [1n], transformers: [] },
+    starterArguments: '0x5678', otherArguments: '0xabcd', sig: '0x0102',
+  };
+  const calldata = Depository__factory.createInterface().encodeFunctionData('watchtowerCounterDispute', [sender, proof, 4n, 11n, '0x0304']);
+  // Depository authorizes the selected counter, then sets executable.sig=""
+  // before hashing DisputeFinalized. Raw calldata.sig is not the emitted evidence.
+  const event = { sender, counterentity: proof.counterentity, initialNonce: 7n, finalProofbodyHash: ZeroHash,
+    finalizationEvidenceHash: keccak256(AbiCoder.defaultAbiCoder().encode(
+      ['bytes32', 'uint256', 'bool', 'bool', 'bytes32', 'bytes32', 'bytes32'],
+      [proof.initialProofbodyHash, proof.finalNonce, proof.proposerIsLeft, proof.startedByLeft,
+        keccak256(proof.starterArguments), keccak256(proof.otherArguments), keccak256('0x')],
+    )) };
+  const candidates = decodeDisputeFinalizationEvidenceCalldata(calldata);
+  expect(resolveDisputeFinalizationEvidence(candidates, ZeroHash, event).sig).toBe('0x');
+  expect(() => resolveDisputeFinalizationEvidence(candidates.map(c => ({ ...c, sig: proof.sig })), ZeroHash, event))
+    .toThrow('J_DISPUTE_FINALIZATION_EVIDENCE_NOT_FOUND');
+});
