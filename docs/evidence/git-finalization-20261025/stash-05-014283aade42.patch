-        .ok_or_else(|| err(format!("{code}_DIGEST")))?;
-    if body.bytes().any(|byte| byte.is_ascii_uppercase()) {
-        return Err(err(format!("{code}_DIGEST_NON_CANONICAL")));
-    }
-    hex::decode(body)
-        .map_err(|_| err(format!("{code}_DIGEST")))?
-        .try_into()
-        .map_err(|_| err(format!("{code}_DIGEST")))
-}
