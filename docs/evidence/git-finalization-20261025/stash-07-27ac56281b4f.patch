+
+/* ---------- brainvault work factor picker ---------- */
+
+.gate-factors {
+	display: grid;
+	grid-template-columns: repeat(5, 1fr);
+	gap: 6px;
+}
+
+@media (max-width: 520px) {
+	.gate-factors {
+		grid-template-columns: repeat(3, 1fr);
+	}
+}
+
+.gate-factor {
+	border: 1px solid var(--hairline);
+	border-radius: var(--radius-m);
+	padding: 10px 6px;
+	display: flex;
+	flex-direction: column;
+	align-items: center;
+	gap: 3px;
+	color: var(--ink-2);
+	transition:
+		border-color var(--dur-fast) var(--ease),
+		color var(--dur-fast) var(--ease);
+}
+
+.gate-factor:hover {
+	border-color: var(--hairline-2);
+}
+
+.gate-factor.active {
+	border-color: var(--champagne);
+	color: var(--ink);
+}
+
+.gate-factor-tier {
+	font-size: 12px;
+	font-weight: 500;
+}
+
+.gate-factor-shards {
+	font-size: 10.5px;
+	color: var(--ink-3);
+	font-variant-numeric: tabular-nums;
+}
+
+/* ---------- full-width identifiers ---------- */
+
+.hash {
+	font-family: var(--font-mono);
+	font-size: 11px;
+	color: var(--ink-2);
+	overflow-wrap: anywhere;
+	word-break: break-all;
+	line-height: 1.5;
+}
+
+/* ---------- canonical delta bar: [own credit][collateral][peer credit] + Δ marker ---------- */
+
+.dbar {
+	position: relative;
+	display: flex;
+	width: 100%;
+	border-radius: 4px;
+	overflow: visible;
+}
+
+.dbar-zone {
+	height: 100%;
+}
+
+.dbar-zone:first-child {
+	border-radius: 4px 0 0 4px;
+}
+
+.dbar-zone:nth-last-child(2) {
+	border-radius: 0 4px 4px 0;
+}
+
+.dbar-own {
+	background: color-mix(in srgb, var(--champagne) 42%, transparent);
+}
+
+.dbar-coll {
+	background: #7fae8e;
+}
+
+.dbar-peer {
+	background: var(--hairline-2);
+}
+
+.dbar-marker {
+	position: absolute;
+	top: -4px;
+	bottom: -4px;
+	width: 2px;
+	margin-left: -1px;
+	background: var(--ink);
+	border-radius: 1px;
+	box-shadow: 0 0 6px color-mix(in srgb, var(--ink) 50%, transparent);
+}
+
+.dbar-marker-chip {
+	width: 2px !important;
+	height: 12px !important;
+	border-radius: 1px !important;
+	background: var(--ink);
+}
+
+.delta-legend {
+	display: flex;
+	gap: 14px;
+	flex-wrap: wrap;
+	font-size: 11px;
+	color: var(--ink-3);
+}
+
+.delta-legend span {
+	display: inline-flex;
+	align-items: center;
+	gap: 6px;
+}
+
+.delta-legend i {
+	width: 10px;
+	height: 8px;
+	border-radius: 2px;
+	display: inline-block;
+}
+
+/* ---------- testnet faucet chip ---------- */
+
+.faucet-chip {
+	display: inline-flex;
+	align-items: center;
+	gap: 6px;
+	border: 1px solid color-mix(in srgb, #7fae8e 55%, transparent);
+	color: #7fae8e;
+	border-radius: var(--radius-pill);
+	padding: 5px 12px;
+	font-size: 11.5px;
+	font-weight: 500;
+	white-space: nowrap;
+	transition: background var(--dur-fast) var(--ease);
+}
+
+.faucet-chip:hover:not(:disabled) {
+	background: color-mix(in srgb, #7fae8e 12%, transparent);
+}
+
+/* ---------- pay form: recipient picker ---------- */
+
+.picker {
