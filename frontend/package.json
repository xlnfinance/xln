{
	"name": "frontend",
	"private": true,
	"version": "0.1.31",
	"type": "module",
	"scripts": {
		"dev": "node copy-static-files.js && vite dev",
		"dev:react": "XLN_FRONTEND_SURFACE=all vite --config vite.react.config.ts --host 127.0.0.1 --port 8080",
		"build": "node copy-static-files.js && vite build",
		"build:react:site": "XLN_FRONTEND_SURFACE=site vite build --config vite.react.config.ts",
		"build:static": "node copy-static-files.js && vite build && echo 'Built for GitHub Pages deployment'",
		"native:build": "cd .. && bun run native:mobile",
		"native:ios": "cd .. && bun run native:ios -- --open",
		"native:android": "cd .. && bun run native:android -- --open",
		"native:sync": "cd .. && bun run native:mobile -- --no-build",
		"native:doctor": "cap doctor",
		"preview": "node prepare-preview-assets.js && vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "bun copy-static-files.js && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --threshold error && bun scripts/vite-build-check.ts && bun run check:react",
		"check:react": "tsc -p tsconfig.react.json --noEmit && bun run build:react:site",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "bun ../runtime/scripts/run-with-test-cleanup.ts --cwd=.. --reason=frontend-playwright --scope=e2e -- playwright test",
		"test:landing": "cd .. && bun run test:e2e:static-frontend tests/landing-site.spec.ts",
		"test:fed": "bun ../runtime/scripts/run-with-test-cleanup.ts --cwd=.. --reason=frontend-fed --scope=e2e -- playwright test tests/fed-chair-demo.spec.ts",
		"test:ui": "bun ../runtime/scripts/run-with-test-cleanup.ts --cwd=.. --reason=frontend-ui --scope=e2e -- playwright test --ui"
	},
	"devDependencies": {
		"@capacitor/android": "^8.5.0",
		"@capacitor/cli": "^8.5.0",
		"@capacitor/ios": "^8.5.0",
		"@sveltejs/adapter-auto": "^6.1.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.2",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@types/bun": "1.3.14",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4",
		"@vitejs/plugin-react": "^5.2.0",
		"marked": "^16.4.2",
		"svelte": "^5.56.8",
		"svelte-check": "^4.7.4",
		"svelte-multiselect": "^11.8.0",
		"typescript": "^5.9.3",
		"vite": "^7.3.6"
	},
	"dependencies": {
		"@capacitor/app": "^8.1.1",
		"@capacitor/core": "^8.5.0",
		"@capacitor/device": "^8.0.3",
		"@capacitor/filesystem": "^8.1.2",
		"@capacitor/haptics": "^8.0.2",
		"@capacitor/keyboard": "^8.0.5",
		"@capacitor/local-notifications": "^8.2.1",
		"@capacitor/preferences": "^8.0.1",
		"@capacitor/push-notifications": "^8.1.2",
		"@capacitor/splash-screen": "^8.0.2",
		"@capacitor/status-bar": "^8.0.3",
		"@scure/bip39": "^2.2.0",
		"@types/three": "^0.180.0",
		"dockview": "^4.13.1",
		"hash-wasm": "^4.12.0",
		"jsqr": "^1.4.0",
		"lucide-svelte": "^0.544.0",
		"qrcode": "^1.5.4",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"three": "^0.180.0"
	},
	"overrides": {
		"picomatch": "4.0.5",
		"rollup": "4.62.2"
	}
}
