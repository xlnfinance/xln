{
  "name": "frontend",
  "private": true,
  "version": "0.1.31",
  "type": "module",
  "scripts": {
    "dev": "node copy-static-files.js && vite dev",
    "build": "node copy-static-files.js && vite build",
    "build:static": "node copy-static-files.js && vite build && echo 'Built for GitHub Pages deployment'",
    "native:build": "bun run build && cap sync",
    "native:ios": "bun run native:build && cap open ios",
    "native:android": "bun run native:build && cap open android",
    "native:sync": "cap sync",
    "native:doctor": "cap doctor",
    "preview": "node scripts/prepare-preview-assets.js && vite preview",
    "prepare": "svelte-kit sync",
    "check": "bun run check:unsafe-types && bun copy-static-files.js && svelte-kit sync && bun ../tools/run-parallel-checks.ts check:svelte check:build",
    "check:svelte": "svelte-check --tsconfig ./tsconfig.json --threshold error",
    "check:build": "bun scripts/vite-build-check.ts",
    "check:unsafe-types": "bun scripts/check-unsafe-types.ts",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "bun ../core/scripts/e2e/runners/run-with-test-cleanup.ts --cwd=.. --reason=frontend-playwright --scope=e2e -- playwright test",
    "test:ui": "bun ../core/scripts/e2e/runners/run-with-test-cleanup.ts --cwd=.. --reason=frontend-ui --scope=e2e -- playwright test --ui"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "marked": "^18.1.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "svelte-multiselect": "^11.8.0",
    "typescript": "6.0.3",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/device": "^8.0.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/push-notifications": "^8.1.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@scure/bip39": "^2.4.0",
    "@types/three": "^0.186.0",
    "dockview": "^8.6.0",
    "hash-wasm": "^4.12.0",
    "jsqr": "^1.4.0",
    "lucide-svelte": "^1.0.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.186.1"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "overrides": {
    "uuid": "14.0.3"
  }
}
