{
  "name": "frontend",
  "private": true,
  "version": "0.1.31",
  "type": "module",
  "scripts": {
    "dev": "bun copy-static-files.js && XLN_FRONTEND_SURFACE=all vite --config vite.config.ts --host 127.0.0.1 --port 8080",
    "build": "bun scripts/build-surfaces.ts",
    "build:static": "bun run build",
    "docs:produce": "bun scripts/docs-catalog-producer.ts --input ../docs --output static/docs-catalog",
    "native:build": "cd .. && bun run native:mobile",
    "native:ios": "cd .. && bun run native:ios -- --open",
    "native:android": "cd .. && bun run native:android -- --open",
    "native:sync": "cd .. && bun run native:mobile -- --no-build",
    "native:doctor": "cap doctor",
    "preview": "bun copy-static-files.js && XLN_FRONTEND_SURFACE=all vite build --config vite.config.ts && XLN_FRONTEND_SURFACE=all vite preview --config vite.config.ts",
    "check": "tsc -p tsconfig.json --noEmit && bun run build",
    "check:watch": "tsc -p tsconfig.json --noEmit --watch",
    "test": "bun ../runtime/scripts/run-with-test-cleanup.ts --cwd=.. --reason=frontend-playwright --scope=e2e -- playwright test",
    "test:landing": "cd .. && bun run test:e2e:static-frontend tests/landing-site.spec.ts",
    "test:fed": "bun ../runtime/scripts/run-with-test-cleanup.ts --cwd=.. --reason=frontend-fed --scope=e2e -- playwright test tests/fed-chair-demo.spec.ts",
    "test:ui": "bun ../runtime/scripts/run-with-test-cleanup.ts --cwd=.. --reason=frontend-ui --scope=e2e -- playwright test --ui"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "@types/bun": "1.3.14",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "marked": "^16.4.2",
    "typescript": "^5.9.3",
    "vite": "^7.3.6"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.0",
    "@capacitor/device": "^8.0.3",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/local-notifications": "^8.2.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/push-notifications": "^8.1.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@scure/bip39": "^2.2.0",
    "@types/three": "^0.180.0",
    "dockview": "^4.13.1",
    "dompurify": "^3.4.13",
    "hash-wasm": "^4.12.0",
    "jsqr": "^1.4.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.180.0"
  },
  "overrides": {
    "picomatch": "4.0.5",
    "rollup": "4.62.2"
  }
}
