{
  "name": "xln-contracts",
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "compile": "bunx hardhat clean && bunx hardhat compile",
    "compile:tron": "bun scripts/compile-tron.cjs --all",
    "deploy:chains:testnet": "bun scripts/deploy-chain-matrix.cjs --profile=testnet --write-jurisdictions",
    "deploy:chains:mainnet": "bun scripts/deploy-chain-matrix.cjs --profile=mainnet --yes --write-jurisdictions",
    "test": "bun ../core/scripts/e2e/runners/run-with-test-cleanup.ts --cwd=.. --reason=contracts -- bunx hardhat test",
    "test:default": "bun ../core/scripts/e2e/runners/run-with-test-cleanup.ts --cwd=.. --reason=contracts-default -- bunx hardhat test",
    "forge:setup": "bash scripts/setup-forge-std.sh",
    "test:forge": "bun run forge:setup && forge test --root .",
    "test:forge:deep": "bun run forge:setup && FOUNDRY_PROFILE=deep forge test --root . --match-path 'test/foundry/*.invariants.t.sol'",
    "deploy": "bun scripts/deploy-chain-matrix.cjs",
    "console": "bunx hardhat console",
    "node": "anvil --host 0.0.0.0 --port 8545 --chain-id 31337 --block-gas-limit 60000000 --code-size-limit 65536"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "^4.2.1",
    "@nomicfoundation/hardhat-ethers-chai-matchers": "^3.0.13",
    "@nomicfoundation/hardhat-ignition": "^3.1.9",
    "@nomicfoundation/hardhat-ignition-ethers": "^3.1.6",
    "@nomicfoundation/hardhat-keystore": "^3.1.2",
    "@nomicfoundation/hardhat-mocha": "^4.0.1",
    "@nomicfoundation/hardhat-network-helpers": "^3.0.12",
    "@nomicfoundation/hardhat-toolbox-mocha-ethers": "^4.0.0",
    "@nomicfoundation/hardhat-typechain": "^3.1.2",
    "@nomicfoundation/hardhat-verify": "^3.1.3",
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "chai": "^6.3.0",
    "ethers": "6.17.0",
    "hardhat": "^3.20.0",
    "mocha": "^12.0.3",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.6.1"
  }
}
