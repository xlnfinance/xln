{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "core/runtime.ts",
    "core/api/public/runtime-public.ts",
    "core/api/public/runtime-module.ts",
    "core/api/server/index.ts",
    "core/scripts/**/*.ts",
    "core/scenarios/**/*.ts",
    "core/__tests__/**/*.test.ts",
    "core/__tests__/types/fints/**/*.ts",
    "scripts/**/*.ts",
    "tools/*.ts",
    "tools/release-snapshot/assert-clean.ts",
    "tools/hlt-viz/*.ts",
    "tests/**/*.spec.ts",
    "tests/**/*.test.ts",
    "custody/**/*.ts",
    "core/orchestrator/hub-node.ts",
    "core/orchestrator/mm-node.ts",
    "core/orchestrator/orchestrator.ts",
    "core/__tests__/fixtures/**/*.ts",
    "core/api/server/cli.ts",
    "core/qa/tools/code-fingerprint-cli.ts",
    "core/qa/tools/runtime-state-diff-cli.ts",
    "jurisdictions/hardhat.config.ts",
    "jurisdictions/test/**/*.{ts,mjs}"
  ],
  "project": [
    "core/**/*.ts",
    "scripts/**/*.ts",
    "tools/**/*.ts",
    "custody/**/*.ts",
    "jurisdictions/test/**/*.{ts,mjs}"
  ],
  "ignore": [
    "frontend/**"
  ],
  "ignoreDependencies": [
    "@openzeppelin/contracts",
    "buffer",
    "dockview",
    "chai-as-promised",
    "solc",
    "electron",
    "@typescript/native",
    "@tsconfig/node20",
    "@types/minimatch",
    "@stryker-mutator/command-runner",
    "three"
  ]
}
