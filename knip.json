{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "core/runtime.ts",
    "core/api/public/runtime-public.ts",
    "core/api/public/runtime-module.ts",
    "core/api/server/index.ts",
    "core/scripts/**/*.ts",
    "core/scenarios/**/*.ts",
    "core/__tests__/**/*.test.ts",
    "core/__tests__/types/fints/**/*.ts",
    "scripts/**/*.ts",
    "tools/*.ts",
    "tests/**/*.spec.ts",
    "tests/**/*.test.ts",
    "custody/**/*.ts",
    "core/orchestrator/hub-node.ts",
    "core/orchestrator/mm-node.ts",
    "core/orchestrator/orchestrator.ts",
    "brainvault/worker-browser.ts",
    "brainvault/worker-native.ts",
    "brainvault/worker-wasm.ts",
    "core/__tests__/fixtures/**/*.ts",
    "core/api/server/cli.ts",
    "core/qa/tools/code-fingerprint-cli.ts",
    "core/qa/tools/runtime-state-diff-cli.ts"
  ],
  "project": [
    "core/**/*.ts",
    "scripts/**/*.ts",
    "tools/**/*.ts",
    "custody/**/*.ts",
    "brainvault/**/*.ts"
  ],
  "ignore": [
    "frontend/**"
  ],
  "ignoreDependencies": [
    "argon2",
    "buffer",
    "dockview",
    "@nomicfoundation/hardhat-toolbox",
    "@types/mocha",
    "chai-as-promised",
    "mocha",
    "solc",
    "electron",
    "@typescript/native",
    "@tsconfig/node20",
    "@types/minimatch",
    "@stryker-mutator/command-runner",
    "three"
  ]
}
