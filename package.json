    "test:e2e:full": "bun core/scripts/e2e/runners/run-e2e-parallel-isolated.ts --all --strict-browser-health --shards=7 --workers-per-shard=1 --max-mm-concurrency=1 --stack-timeout-ms=300000 --video=retain-on-failure --trace=off --screenshot=only-on-failure --max-failures=1",
    "test:e2e:release": "bun run prod:bootstrap:soundcheck && bun core/scripts/e2e/runners/run-e2e-parallel-isolated.ts --all --exclude-market-maker --strict-browser-health --shards=7 --workers-per-shard=1 --stack-timeout-ms=300000 --video=retain-on-failure --trace=off --screenshot=only-on-failure --max-failures=1",
    "test:e2e:mm": "bun run prod:bootstrap:soundcheck && bun core/scripts/e2e/runners/run-e2e-parallel-isolated.ts --all --market-maker-only --strict-browser-health --shards=7 --workers-per-shard=1 --max-mm-concurrency=1 --stack-timeout-ms=300000 --video=retain-on-failure --trace=off --screenshot=only-on-failure --max-failures=1",
    "test:e2e:all": "bun core/scripts/e2e/runners/run-e2e-parallel-isolated.ts --all --strict-browser-health --shards=7 --workers-per-shard=1 --max-mm-concurrency=1 --stack-timeout-ms=300000 --video=retain-on-failure --trace=off --screenshot=only-on-failure --max-failures=1",
    "test:e2e:payment:smoke": "bun core/scripts/e2e/runners/run-e2e-parallel-isolated.ts --strict-browser-health --shards=1 --workers-per-shard=1 --pw-project=chromium --pw-files=tests/e2e/payments/e2e-payment-smoke.spec.ts",
    "test:e2e:prod:payment": "PW_SKIP_WEBSERVER=1 PW_ONLY_CHROMIUM=1 PW_BASE_URL=https://xln.finance E2E_BASE_URL=https://xln.finance E2E_API_BASE_URL=https://xln.finance PW_VIDEO=retain-on-failure PW_TRACE=on-first-retry bun core/scripts/e2e/runners/run-with-test-cleanup.ts --reason=e2e-prod-payment --scope=e2e -- bunx playwright test tests/e2e/payments/e2e-payment-smoke.spec.ts --project=chromium",
    "test:e2e:parallel:isolated": "bun core/scripts/e2e/runners/run-e2e-parallel-isolated.ts --strict-browser-health",
    "test:e2e:parallel:max": "E2E_LONG=1 bun core/scripts/e2e/runners/run-e2e-parallel-isolated.ts --strict-browser-health --shards=7 --workers-per-shard=1 --stack-timeout-ms=300000 --video=retain-on-failure --trace=off --screenshot=only-on-failure --max-failures=1",
    "test:e2e:parallel:long": "E2E_LONG=1 bun core/scripts/e2e/runners/run-e2e-parallel-isolated.ts --strict-browser-health --shards=7 --workers-per-shard=1 --max-mm-concurrency=1 --video=retain-on-failure --trace=off --screenshot=only-on-failure --max-failures=1",
    "test:e2e:mvp": "bun core/scripts/e2e/runners/run-e2e-parallel-isolated.ts --strict-browser-health --video=retain-on-failure --trace=off --screenshot=only-on-failure --max-failures=1",
