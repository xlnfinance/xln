    "bench:radapter:hub10k": "bun --expose-gc core/scripts/operations/benchmark/bench-radapter-hub-1m.ts --accounts=10000 --hot-percent=10 --memory=hot --seed-mode=bulk --chunk=1000 --traffic-rounds=10 --touch-per-round=100 --new-after-read=100 --rss-cap-mb=1024 --max-read-p99-ms=500 --max-durable-p99-ms=2000 --max-cold-open-ms=1000 --max-cold-read-ms=500",
    "bench:radapter:hub10k:rotation": "bun --expose-gc core/scripts/operations/benchmark/bench-radapter-hub-1m.ts --accounts=10000 --hot-percent=10 --memory=hot --seed-mode=bulk --chunk=1000 --traffic-rounds=10 --touch-per-round=100 --new-after-read=100 --rotation-probe --rotation-epoch-bytes=1073741824 --rss-cap-mb=1024 --max-read-p99-ms=500 --max-durable-p99-ms=2000 --max-cold-open-ms=1000 --max-cold-read-ms=500 --max-snapshot-ms=5000 --max-epoch-seed-ms=5000 --max-rotation-probe-ms=10000",
    "bench:radapter:hub100k:hot10k": "bun --expose-gc core/scripts/operations/benchmark/bench-radapter-hub-1m.ts --accounts=100000 --hot-accounts=10000 --memory=hot --seed-mode=bulk --chunk=5000 --traffic-rounds=10 --touch-per-round=100 --new-after-read=100 --rss-cap-mb=2048 --max-read-p99-ms=750 --max-durable-p99-ms=3000 --max-cold-open-ms=1500 --max-cold-read-ms=750",
    "bench:radapter:hub1m:assert": "bun --expose-gc core/scripts/operations/benchmark/bench-radapter-hub-1m.ts --accounts=1000000 --hot-percent=1 --memory=hot --seed-mode=bulk --chunk=10000 --traffic-rounds=10 --touch-per-round=100 --new-after-read=100 --rss-cap-mb=24576 --max-read-p99-ms=1000 --max-durable-p99-ms=8000 --max-cold-open-ms=5000 --max-cold-read-ms=1000 --keep-db",
    "bench:radapter:hub1m:rotation": "bun --expose-gc core/scripts/operations/benchmark/bench-radapter-hub-1m.ts --accounts=1000000 --hot-percent=1 --memory=hot --seed-mode=bulk --chunk=10000 --traffic-rounds=10 --touch-per-round=100 --new-after-read=100 --rotation-probe --rotation-epoch-bytes=1073741824 --rss-cap-mb=24576 --max-read-p99-ms=1000 --max-durable-p99-ms=8000 --max-cold-open-ms=5000 --max-cold-read-ms=1000 --max-snapshot-ms=180000 --max-epoch-seed-ms=180000 --max-rotation-probe-ms=360000 --keep-db",
    "bench:radapter:hub1m": "bun --expose-gc core/scripts/operations/benchmark/bench-radapter-hub-1m.ts --accounts=1000000 --hot-percent=1 --memory=hot --seed-mode=bulk --chunk=10000 --traffic-rounds=10 --touch-per-round=100 --keep-db",
