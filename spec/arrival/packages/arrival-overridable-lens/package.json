{
  "name": "@inhuman.tools/arrival-overridable-lens",
  "version": "0.9.9",
  "description": "Static (pre-eval) substrate for reading a program's `(define/overridable …)` surface: the canonical top-level parse-tree walk plus `foldSchemaTag`, the pre-eval dual of core's post-eval `tagToJsonSchema`. Consumed one-way by the out-of-core overridable lenses — studio form fields, the API `:input` schema, the CLI argv mapper.",
  "keywords": [
    "arrival",
    "overridable",
    "schema",
    "static-analysis"
  ],
  "homepage": "https://github.com/here-build/arrival#readme",
  "bugs": {
    "url": "https://github.com/here-build/arrival/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/here-build/arrival.git",
    "directory": "packages/arrival-overridable-lens"
  },
  "license": "MIT",
  "author": "here.build",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "!**/__tests__",
    "!**/__research__",
    "!**/__benchmarks__",
    "!**/__custdev__",
    "!**/__visual__",
    "!**/*.test.*",
    "!**/*.stories.*"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@inhuman.tools/arrival": "workspace:^",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@here.build/eslint-configs": "0.9.0",
    "@here.build/tsconfig": "0.9.0",
    "@types/node": "24.0.0",
    "eslint": "9.39.5",
    "globals": "17.12.0",
    "prettier": "3.8.1",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
