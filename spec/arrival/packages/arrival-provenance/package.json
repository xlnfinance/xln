{
  "name": "@inhuman.tools/arrival-provenance",
  "version": "0.9.9",
  "description": "The trace-capture substrate (re-exported from @inhuman.tools/arrival's `/provenance` subpath) plus the full render-model analysis stack — forest, statechart, region tree, flow graph, reverse-chain slicer — owned natively here (provenance analysis-stack relocation; core keeps only the capture spine + static wireframe plane). `./reflect` is the query layer over a finished run (ResultHandle + why/where/how/dag/blast + arrival/reflect capability). The one non-passthrough export is EvalTrace: this package's is the mobx-reactive ObservableEvalTrace, kept here so studio/UI consumers keep byte-identical reactive semantics without core taking on a mobx dependency.",
  "keywords": [
    "arrival",
    "provenance",
    "trace",
    "dataflow",
    "slicing"
  ],
  "homepage": "https://github.com/here-build/arrival#readme",
  "bugs": {
    "url": "https://github.com/here-build/arrival/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/here-build/arrival.git",
    "directory": "packages/arrival-provenance"
  },
  "license": "MIT",
  "author": "here.build",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./analysis": {
      "types": "./dist/analysis.d.ts",
      "import": "./dist/analysis.js"
    },
    "./verdict": {
      "types": "./dist/verdict.d.ts",
      "import": "./dist/verdict.js"
    },
    "./reflect": {
      "types": "./dist/reflect.d.ts",
      "import": "./dist/reflect.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "!**/__tests__",
    "!**/__research__",
    "!**/__benchmarks__",
    "!**/__custdev__",
    "!**/__visual__",
    "!**/*.test.*",
    "!**/*.stories.*"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@inhuman.tools/arrival": "workspace:^",
    "@inhuman.tools/arrival-sugarcoat": "workspace:^",
    "mobx": "6.15.0",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@here.build/eslint-configs": "0.9.0",
    "@here.build/tsconfig": "0.9.0",
    "@types/node": "24.0.0",
    "eslint": "9.39.5",
    "globals": "17.12.0",
    "prettier": "3.8.1",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
