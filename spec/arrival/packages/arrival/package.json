{
  "name": "@inhuman.tools/arrival",
  "version": "0.9.10",
  "description": "R7RS-subset Scheme interpreter for AI-agent constraint-based execution — transparent provenance, capability sandbox, JS membrane",
  "keywords": [
    "scheme",
    "lisp",
    "interpreter",
    "sandbox",
    "s-expressions"
  ],
  "homepage": "https://github.com/here-build/arrival#readme",
  "bugs": {
    "url": "https://github.com/here-build/arrival/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/here-build/arrival.git",
    "directory": "packages/arrival"
  },
  "license": "MIT",
  "author": "here.build",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./reflect-internals": {
      "types": "./dist/reflect-internals/index.d.ts",
      "default": "./dist/reflect-internals/index.js"
    },
    "./lsp-internals": {
      "types": "./dist/lsp-internals/index.d.ts",
      "default": "./dist/lsp-internals/index.js"
    },
    "./host-internals": {
      "types": "./dist/host-internals/index.d.ts",
      "default": "./dist/host-internals/index.js"
    },
    "./capability": {
      "types": "./dist/common/capability.d.ts",
      "default": "./dist/common/capability.js"
    },
    "./capabilities": {
      "types": "./dist/capabilities/index.d.ts",
      "default": "./dist/capabilities/index.js"
    },
    "./capabilities/overridable": {
      "types": "./dist/env/overridable/overridable.d.ts",
      "default": "./dist/env/overridable/overridable.js"
    },
    "./capabilities/schema": {
      "types": "./dist/env/schema/schema.d.ts",
      "default": "./dist/env/schema/schema.js"
    },
    "./resources": {
      "types": "./dist/common/resources-surface/index.d.ts",
      "default": "./dist/common/resources-surface/index.js"
    },
    "./emit": {
      "types": "./dist/emit/index.d.ts",
      "default": "./dist/emit/index.js"
    },
    "./schema-tag": {
      "types": "./dist/common/schema-tag.d.ts",
      "default": "./dist/common/schema-tag.js"
    },
    "./attestation": {
      "types": "./dist/values/attestation-surface/index.d.ts",
      "default": "./dist/values/attestation-surface/index.js"
    },
    "./provenance": {
      "types": "./dist/provenance/index.d.ts",
      "default": "./dist/provenance/index.js"
    },
    "./provenance/store": {
      "types": "./dist/provenance/store/index.d.ts",
      "default": "./dist/provenance/store/index.js"
    },
    "./type-layer": {
      "types": "./dist/type-layer/index.d.ts",
      "default": "./dist/type-layer/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "docs",
    "!**/__tests__",
    "!**/__research__",
    "!**/__benchmarks__",
    "!**/__custdev__",
    "!**/__visual__",
    "!**/*.test.*",
    "!**/*.test-d.*",
    "!**/*.stories.*",
    "!**/*.map"
  ],
  "scripts": {
    "build": "node scripts/gen-carriers-text.mjs && node -e \"fs.rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check:doc-anchors": "node scripts/check-doc-anchors.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test-d": "vitest run --config vitest.typecheck.config.ts",
    "benchmarks": "vitest run --config vitest.benchmarks.config.ts",
    "experiments": "vitest run --config vitest.experiments.config.ts",
    "typecheck": "tsc --noEmit && vitest run --config vitest.typecheck.config.ts",
    "workerd": "vitest run --config vitest.workerd.config.ts"
  },
  "dependencies": {
    "@here.build/error-invariant": "0.9.0",
    "@inhuman.tools/arrival-syntax": "workspace:^",
    "dedent": "1.7.2",
    "fold-case": "1.0.0",
    "tiny-invariant": "1.3.3",
    "tslib": "2.8.1",
    "unicode-properties": "1.4.1",
    "zod": "^4.5.4",
    "zod-to-ts": "2.1.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.13.2",
    "@cloudflare/workers-types": "4.20260702.1",
    "@here.build/eslint-configs": "0.9.0",
    "@here.build/tsconfig": "0.9.0",
    "@types/node": "24.0.0",
    "eslint": "9.39.5",
    "fast-check": "4.9.0",
    "globals": "17.12.0",
    "prettier": "3.8.1",
    "typescript": "6.0.3",
    "vitest": "4.1.11",
    "wrangler": "4.107.1"
  }
}
