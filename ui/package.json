{
  "name": "xln-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "runtime:bundle": "XLN_RUNTIME_BUNDLE_OUT=ui/public/runtime.js bash ../scripts/build-runtime.sh",
    "dev": "bun run runtime:bundle && vite",
    "build": "bun run runtime:bundle && vite build",
    "build:hosted": "XLN_UI_BASE=/ui/ bun run build",
    "preview": "vite preview",
    "check": "tsc --noEmit -p tsconfig.json --checkers 4",
    "test:e2e": "bunx playwright test -c playwright.config.ts"
  },
  "dependencies": {
    "ethers": "^6.17.0",
    "events": "3.3.0",
    "hash-wasm": "^4.12.0",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.59.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/bun": "^1.4.3",
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
